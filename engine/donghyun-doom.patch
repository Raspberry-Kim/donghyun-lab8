diff --git a/src/doom/p_mobj.c b/src/doom/p_mobj.c
index ab71b50..159d68e 100644
--- a/src/doom/p_mobj.c
+++ b/src/doom/p_mobj.c
@@ -684,6 +684,47 @@ void P_RespawnSpecials (void)
 // Most of the player structure stays unchanged
 //  between levels.
 //
+
+/* 동현둠: 동현랭 출전 코드가 정한 값. 명령줄 -dhhealth -dharmor -dhgod -dhkfa로 받는다. */
+#include "m_argv.h"
+#include "deh_misc.h"
+#include <stdlib.h>
+static void DH_Apply(player_t *p, boolean reborn)
+{
+    static int loaded = 0, health = 100, armor = 0, god = 0, kfa = 0;
+    int i;
+    if (!loaded)
+    {
+        loaded = 1;
+        i = M_CheckParmWithArgs("-dhhealth", 1); if (i) health = atoi(myargv[i+1]);
+        i = M_CheckParmWithArgs("-dharmor", 1);  if (i) armor = atoi(myargv[i+1]);
+        god = M_CheckParm("-dhgod") != 0;
+        kfa = M_CheckParm("-dhkfa") != 0;
+        if (health < 1) health = 1; if (health > 200) health = 200;
+        if (armor < 0) armor = 0; if (armor > 200) armor = 200;
+    }
+    if (reborn)
+    {
+        p->health = health;
+        p->armorpoints = armor;
+        p->armortype = armor > 100 ? 2 : (armor > 0 ? 1 : 0);
+    }
+    /* 맵이 시작될 때마다 Shareware 무기 6종: 주먹·전기톱·권총·산탄총·기관총·로켓 발사기 */
+    p->weaponowned[wp_fist] = p->weaponowned[wp_chainsaw] = p->weaponowned[wp_pistol] = true;
+    p->weaponowned[wp_shotgun] = p->weaponowned[wp_chaingun] = p->weaponowned[wp_missile] = true;
+    if (p->ammo[am_clip] < 100) p->ammo[am_clip] = 100;
+    if (p->ammo[am_shell] < 20) p->ammo[am_shell] = 20;
+    if (p->ammo[am_misl] < 10) p->ammo[am_misl] = 10;
+    if (god) p->cheats |= CF_GODMODE;
+    if (kfa)
+    {
+        p->armorpoints = deh_idkfa_armor;
+        p->armortype = deh_idkfa_armor_class;
+        for (i = 0; i < NUMWEAPONS; i++) p->weaponowned[i] = true;
+        for (i = 0; i < NUMAMMO; i++) p->ammo[i] = p->maxammo[i];
+        for (i = 0; i < NUMCARDS; i++) p->cards[i] = true;
+    }
+}
 void P_SpawnPlayer (mapthing_t* mthing)
 {
     player_t*		p;
